{
  "name": "under-clothing",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "node scripts/run.mjs start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
